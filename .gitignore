# Local kernel connection keys/runtime state are not experiment results.
/experiments/results/JUPYTER-OFFLINE-*/jupyter/
/experiments/results/JUPYTER-OFFLINE-*/ipython/
# Notebook kernel connection keys and runtime caches are not study evidence.
/experiments/results/SG-LESSON-*/kernel/
/experiments/results/VISION-LESSON-*/kernel/
!/experiments/results/VISION-LESSON-*/*.ipynb
# Small checksum-bound UVG truth/prediction masks support archived metric replay.
!/experiments/results/UVG-DETECTORS-*/*.npz
